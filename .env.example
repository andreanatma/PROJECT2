# # Database (MySQL 8+). Jangan commit file .env
# DATABASE_URL="mysql://apex_user:GANTI_PASSWORD@localhost:3306/apex_global"

# # URL publik situs (dipakai untuk canonical, sitemap, Open Graph)
# SITE_URL="http://localhost:3000"

# # Sesi admin
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_HOURS=12

# # Token sekali pakai untuk membuat Super Admin pertama lewat /dashboard-admin/signup
# # Buat dengan: openssl rand -hex 24 . Kosongkan/hapus setelah Super Admin dibuat.
# BOOTSTRAP_TOKEN=""

# # Upload
# UPLOAD_DIR="./storage/uploads"
# MAX_UPLOAD_MB=8

# # Opsional: dipakai oleh `npm run db:seed` untuk membuat Super Admin (tanpa default password)
# SEED_ADMIN_NAME=""
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Database Cloud (Ganti dengan URL database cloud Anda, misalnya dari Aiven, TiDB, atau Railway)
DATABASE_URL="mysql://username:password@host-cloud-anda:3306/nama_database"

# URL publik situs (Ganti dengan domain proyek Vercel Anda)
SITE_URL="https://superadmin-omega-seven.vercel.app/"

# Sesi admin
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Token sekali pakai untuk Super Admin pertama
BOOTSTRAP_TOKEN="3f9a1c7e5b8d2046a1e7c93b5d08f2a64c1b9e7d03a5f284"

# Upload limit
MAX_UPLOAD_MB=8