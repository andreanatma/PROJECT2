# Database (MySQL 8+). Jangan commit file .env
DATABASE_URL="mysql://apex_user:GANTI_PASSWORD@localhost:3306/apex_global"

# URL publik situs (dipakai untuk canonical, sitemap, Open Graph)
SITE_URL="http://localhost:3000"

# Sesi admin
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Token sekali pakai untuk membuat Super Admin pertama lewat /dashboard-admin/signup
# Buat dengan: openssl rand -hex 24 . Kosongkan/hapus setelah Super Admin dibuat.
BOOTSTRAP_TOKEN=""

# Upload
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB=8

# Opsional: dipakai oleh `npm run db:seed` untuk membuat Super Admin (tanpa default password)
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
